    {
      "parameters": {
        "jsCode": "const src = $('Normalize Lead').first().json;\nconst j = $input.first().json;\nlet raw = j.content?.parts?.[0]?.text ?? j.candidates?.[0]?.content?.parts?.[0]?.text ?? j.text ?? j.output ?? \"\";\nlet parsed = null;\nif (raw && typeof raw === \"object\") {\n  parsed = raw;\n} else if (raw) {\n  try {\n    parsed = JSON.parse(String(raw).replace(/```json|```/g, \"\").trim());\n  } catch (e) {\n    parsed = null;\n  }\n}\nif (!parsed || typeof parsed !== \"object\" || parsed.score === undefined) {\n  parsed = { city_verified: src.City, state: \"\", grid_zone: \"Semi-Urban\", system_size_kw: 3, solar_potential: \"Medium\", subsidy_eligible: false, score: 50, category: \"Warm\", reason: \"AI scoring unavailable - default Warm score, review manually\", followup_priority: \"24h\" };\n}\nparsed.score = Math.min(100, Math.max(0, Number(parsed.score) || 0));\nparsed.category = parsed.score >= 75 ? \"Hot\" : parsed.score >= 50 ? \"Warm\" : \"Cold\";\nreturn [{ json: parsed }];"
      },
