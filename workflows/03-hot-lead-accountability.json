{
  "name": "SolarLeadOS - Scenario 3: Hot Lead Accountability Loop",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */15 9-19 * * *"
            },
            {
              "field": "cronExpression",
              "expression": "0 0 20 * * *"
            }
          ]
        }
      },
      "id": "4ca34e05-4d1e-40e6-9c7d-3f9830134401",
      "name": "Every 15 min (9-20 IST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -800,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Call_Status",
              "lookupValue": "Pending"
            }
          ]
        },
        "options": {
          "outputFormatting": {
            "values": {
              "general": "FORMATTED_VALUE",
              "date": "FORMATTED_STRING"
            }
          }
        }
      },
      "id": "8f6b2b07-22b1-4408-895c-a62f620f34c0",
      "name": "Get Pending Calls",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -544,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REDACTED",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.Reminder_Sent == \"No\" && DateTime.fromFormat(($json.Alert_Sent_At ?? \"\").toString(), \"dd/MM/yyyy HH:mm\", { zone: \"Asia/Kolkata\" }) < $now.minus({ minutes: 25 }) }}",
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    },
                    "rightValue": true
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Reminder25"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.Escalation_Sent == \"No\" && DateTime.fromFormat(($json.Alert_Sent_At ?? \"\").toString(), \"dd/MM/yyyy HH:mm\", { zone: \"Asia/Kolkata\" }) < $now.minus({ minutes: 45 }) }}",
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    },
                    "rightValue": true
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Escalation45"
            }
          ]
        },
        "looseTypeValidation": true,
        "options": {
          "allMatchingOutputs": true
        }
      },
      "id": "d69c59b1-9e52-4b21-a4d1-b565bbace9c2",
      "name": "Route Overdue Alerts",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        -288,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-WAHA-GATEWAY.example.com/api/sendText",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: \"default\", chatId: \"91XXXXXXXXXX@c.us\", text: \"⚠️ REMINDER: Hot lead not called yet!\\n👤 \" + ($('Get Pending Calls').item.json.Name ?? \"\") + \"\\n📞 +91\" + ($('Get Pending Calls').item.json.Phone ?? \"\") + \"\\n💡 ₹\" + ($('Get Pending Calls').item.json.Monthly_Bill ?? \"\") + \"/mo\\n💯 Score: \" + ($('Get Pending Calls').item.json.Score ?? \"\") + \"/100\\nAlert 25 min pehle gaya tha. Abhi call karo.\\nCall ho gaya? Sheet kholo → Sheet1 tab → Call_Status column → \\\"Called\\\" likh do. Phir reminder band.\" }) }}",
        "options": {}
      },
      "id": "2c217d33-0742-49e7-a739-bb7bffb030bb",
      "name": "WAHA Owner Reminder 25min",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        64,
        -144
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "row_number"
          ],
          "value": {
            "row_number": "={{ $('Get Pending Calls').item.json.row_number }}",
            "Reminder_Sent": "Yes"
          },
          "schema": [
            {
              "id": "row_number",
              "displayName": "row_number",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": true,
              "readOnly": true,
              "removed": false
            },
            {
              "id": "Reminder_Sent",
