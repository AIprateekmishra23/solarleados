    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-WAHA-GATEWAY.example.com/api/sendText",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: \"default\", chatId: \"91XXXXXXXXXX@c.us\", text: \"🚨 FINAL ALERT: Hot lead thanda ho raha hai!\\n👤 \" + ($('Get Pending Calls').item.json.Name ?? \"\") + \"\\n📞 +91\" + ($('Get Pending Calls').item.json.Phone ?? \"\") + \"\\n💡 ₹\" + ($('Get Pending Calls').item.json.Monthly_Bill ?? \"\") + \"/mo\\n45 min ho gaye. Koi call record nahi hua.\\nYe lead ABHI kisi aur installer ko call kar raha hoga.\\nCall now ya lead gaya.\" }) }}",
        "options": {}
      },
