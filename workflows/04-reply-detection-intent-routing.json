    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash-lite",
          "cachedResultName": "Gemini 2.5 Flash-Lite"
        },
        "messages": {
          "values": [
            {
              "content": "=You are classifying a WhatsApp reply from a solar lead in India. The lead earlier received solar follow-up messages. Read their reply and classify the intent.\nReply text: \"{{ $('Normalize Reply').first().json.MessageBody }}\"\nReturn ONLY valid JSON. No markdown, no backticks, no extra text:\n{\"intent\": \"INTERESTED\", \"summary\": \"max 12 words, what the lead wants, in simple English\", \"suggested_reply\": \"max 20 words the installer can send back, in Hinglish\"}\nintent must be exactly one of: INTERESTED, QUESTION, LATER, STOP\nRules:\n- INTERESTED = wants to proceed, book a site visit, get a quote, ready to move forward, or sent a bill photo. Examples: \"haan interested\", \"VISIT\", \"call me\", \"kab aa sakte ho\", \"yes\".\n- QUESTION = asking for information, not yet committed. Price, subsidy, panel type, process, EMI, warranty. Examples: \"kitna cost hoga\", \"subsidy kitni milegi\", \"kaunse panel\".\n- LATER = wants to postpone. Examples: \"abhi nahi\", \"baad me\", \"3 mahine baad\", \"busy hu\".\n- STOP = not interested, already installed, annoyed, opt-out. Examples: \"nahi chahiye\", \"stop\", \"band karo\", \"already lagwa liya\", \"mat bhejo\".\n- If the text says the customer sent a photo/file, classify as INTERESTED (a bill photo is a strong buying signal).\n- If unclear, choose QUESTION.\n- The reply may be Hindi, English, or Hinglish. Understand all three."
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {
          "maxOutputTokens": 2048,
          "temperature": 0.2
        }
      },
