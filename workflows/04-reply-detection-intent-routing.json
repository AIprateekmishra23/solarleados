    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nlet raw = j.content?.parts?.[0]?.text ?? j.candidates?.[0]?.content?.parts?.[0]?.text ?? j.text ?? j.output ?? \"\";\nlet parsed = null;\nif (raw && typeof raw === \"object\") { parsed = raw; } else if (raw) {\n  try { parsed = JSON.parse(String(raw).replace(/```json|```/g, \"\").trim()); } catch (e) { parsed = null; }\n}\nif (!parsed || typeof parsed !== \"object\" || !parsed.intent) {\n  parsed = { intent: \"QUESTION\", summary: \"auto-read failed, please check WhatsApp\", suggested_reply: \"Namaste! Aap batayein, main kaise help kar sakta hun?\" };\n}\nif (![\"INTERESTED\",\"QUESTION\",\"LATER\",\"STOP\"].includes(parsed.intent)) { parsed.intent = \"QUESTION\"; }\nreturn [{ json: parsed }];"
      },
